VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
VITE_API_URL=http://localhost:8000

# Set to false to disable automatic third-party AI categorization/auditing.
VITE_AUTO_AI=true

# Enable only after the pending schema and explicit local card binding are ready.
# This controls display only; it never starts a bank connection.
VITE_PENDING_APPROVALS=false
